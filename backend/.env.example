DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# SQLite is used for simple local launch and demo.
DB_ENGINE=sqlite

